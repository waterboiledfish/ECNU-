# ============================================================
# ECNU 小助手 · 环境变量示例
# 复制为 .env 后按需修改；不要提交真实密钥。
# 所有变量都带 ECNU_ 前缀。
# ============================================================

# ---------- 基础 ----------
# 数据目录（数据库、头像、弹窗临时文件），默认 ~/.ecnu-assistant
# ECNU_DATA_DIR=
ECNU_HOST=127.0.0.1
ECNU_PORT=8765
# 浏览器访问的地址，SSO 回调与生成链接会用到
ECNU_PUBLIC_BASE_URL=http://127.0.0.1:8765
# 站点时区
ECNU_TIMEZONE=Asia/Shanghai
# 用于匿名显示名、签名等；留空则自动生成并保存在数据目录
# ECNU_SECRET_KEY=
# 生产环境务必设为 true（需要 HTTPS）
ECNU_COOKIE_SECURE=false

# ---------- 登录 ----------
# dev：本地演示登录（不连接学校 SSO，仅用于开发/体验）
# cas：学校统一身份认证 CAS（需学校批准并配置）
# oidc：学校 OIDC（需学校批准并配置）
ECNU_AUTH_MODE=dev
ECNU_DEV_LOGIN_ENABLED=true
# 管理员学号/账号，逗号分隔
# ECNU_ADMIN_SUBJECTS=

# CAS
ECNU_CAS_BASE_URL=
ECNU_CAS_LOGIN_PATH=/cas/login
ECNU_CAS_VALIDATE_PATH=/cas/serviceValidate
ECNU_CAS_SERVICE_URL=

# OIDC
ECNU_OIDC_ISSUER=
ECNU_OIDC_CLIENT_ID=
ECNU_OIDC_CLIENT_SECRET=
ECNU_OIDC_REDIRECT_URI=
ECNU_OIDC_SCOPE=openid profile

# ---------- 模型服务 ----------
# 仅作为前端默认值；用户自己的 API Key 从浏览器按请求发送，服务端不落库
ECNU_LLM_BASE_URL=https://api.openai.com/v1
ECNU_LLM_MODEL=gpt-4.1-mini

# ---------- 内容审核（可选） ----------
# 配置后，论坛发帖会额外调用一次 AI 审核；不配置则仅用本地规则
# ECNU_MODERATION_BASE_URL=
# ECNU_MODERATION_API_KEY=
# ECNU_MODERATION_MODEL=
# AI 审核失败时的策略：open（放行，仅记录）或 review（转人工）
ECNU_MODERATION_FAIL_MODE=review

# ---------- 今日热点（可选） ----------
# 默认聚合中国新闻网、界面新闻、IT之家、少数派等公开 RSS
# 可选 Tavily 搜索增强
# ECNU_TAVILY_API_KEY=
# 新闻缓存分钟数
ECNU_NEWS_CACHE_MINUTES=20

# ---------- 论文推荐 ----------
# OpenAlex 礼貌池邮箱（可选；建议填写）
# ECNU_OPENALEX_MAILTO=you@example.com

# ---------- 官网采集 ----------
ECNU_CRAWL_MAX_PAGES_PER_SITE=30
ECNU_CRAWL_MAX_DEPTH=3
ECNU_CRAWL_DELAY_SECONDS=1.0
ECNU_CRAWL_TIMEOUT_SECONDS=15
# 允许采集的域名后缀（逗号分隔）
ECNU_CRAWL_ALLOWED_SUFFIXES=ecnu.edu.cn
# 是否允许普通登录用户触发采集；部署到公网时建议 false
ECNU_ALLOW_USER_CRAWL=true

# ---------- 公共数据库 ----------
ECNU_PORTAL_URL=https://portal2023.ecnu.edu.cn/portal/home
